          <material>
            <ambient>0.18 0.42 0.16 1</ambient>
            <diffuse>0.25 0.58 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: a broad-leaf tree. -->
    <model name="obstacle_1_round_tree">
      <static>true</static>
      <pose>-1.5 -2 0 0 0 0</pose>
      <link name="tree">
        <collision name="trunk_collision">
